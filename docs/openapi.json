{
  "openapi": "3.1.0",
  "info": {
    "title": "Sales Trend API",
    "description": "多平台销量趋势查询。错误体遵循 RFC 9457（application/problem+json）。",
    "version": "1.0.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Readyz",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/product-classes": {
      "get": {
        "tags": [
          "classes"
        ],
        "summary": "List Classes",
        "operationId": "list_classes_v1_product_classes_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/product-classes/{class_slug}": {
      "get": {
        "tags": [
          "classes"
        ],
        "summary": "Get Class",
        "operationId": "get_class_v1_product_classes__class_slug__get",
        "parameters": [
          {
            "name": "class_slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Class Slug"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/meta/freshness": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Freshness",
        "operationId": "freshness_v1_meta_freshness_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/product-classes/{class_slug}/sales-trend": {
      "get": {
        "tags": [
          "trend"
        ],
        "summary": "Sales Trend",
        "operationId": "sales_trend_v1_product_classes__class_slug__sales_trend_get",
        "parameters": [
          {
            "name": "class_slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Class Slug"
            }
          },
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "本地日期，闭区间起点，YYYY-MM-DD",
              "title": "Start Date"
            },
            "description": "本地日期，闭区间起点，YYYY-MM-DD"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "本地日期，闭区间终点（包含），YYYY-MM-DD",
              "title": "End Date"
            },
            "description": "本地日期，闭区间终点（包含），YYYY-MM-DD"
          },
          {
            "name": "platforms",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "逗号分隔，如 app,website；默认全部",
              "title": "Platforms"
            },
            "description": "逗号分隔，如 app,website；默认全部"
          },
          {
            "name": "tz",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "IANA 时区名，默认 UTC；不接受 +08:00 这类固定偏移",
              "title": "Tz"
            },
            "description": "IANA 时区名，默认 UTC；不接受 +08:00 这类固定偏移"
          },
          {
            "name": "granularity",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "day | week | month，默认 day",
              "title": "Granularity"
            },
            "description": "day | week | month，默认 day"
          },
          {
            "name": "rule_version",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "品类规则版本，默认当前版本",
              "title": "Rule Version"
            },
            "description": "品类规则版本，默认当前版本"
          }
        ],
        "responses": {
          "200": {
            "description": "列式趋势。week / month 额外带 days_in_bucket、days_covered、partial、daily_avg 四个平行数组；day 粒度不带",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrendResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Series": {
        "properties": {
          "platform": {
            "type": "string",
            "title": "Platform"
          },
          "values": {
            "items": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array",
            "title": "Values",
            "description": "与 dates 一一对应。0 = 没卖出去；null = 晚于该平台的数据截止"
          }
        },
        "type": "object",
        "required": [
          "platform",
          "values"
        ],
        "title": "Series"
      },
      "SourceTzWarning": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "SOURCE_TZ_UNCONFIRMED"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "platforms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Platforms",
            "description": "源时区未确认、且与请求 tz 不同的平台"
          },
          "source_tz": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Source Tz",
            "description": "这些平台当前假设的源时区"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "platforms",
          "source_tz"
        ],
        "title": "SourceTzWarning"
      },
      "TrendData": {
        "properties": {
          "dates": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Dates",
            "description": "桶的起始本地日期；首个周/月桶从 start_date 起算"
          },
          "series": {
            "items": {
              "$ref": "#/components/schemas/Series"
            },
            "type": "array",
            "title": "Series"
          },
          "total": {
            "items": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array",
            "title": "Total",
            "description": "选中平台之和。全部平台为 null 时为 null；部分为 null 时 = 非 null 平台之和，并记入 partial_dates"
          },
          "days_in_bucket": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Days In Bucket",
            "description": "仅 week / month：桶本身的天数（周 7，月 28–31），不受查询区间裁剪"
          },
          "days_covered": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Days Covered",
            "description": "仅 week / month：桶内落在查询区间、且不晚于数据截止的天数（截止当天算一整天）"
          },
          "partial": {
            "anyOf": [
              {
                "items": {
                  "type": "boolean"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Partial",
            "description": "仅 week / month：days_covered < days_in_bucket，或桶内含 partial_dates 中的日"
          },
          "daily_avg": {
            "anyOf": [
              {
                "items": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Daily Avg",
            "description": "仅 week / month：total / days_covered，保留一位小数；days_covered 为 0 时为 null。只给 total 的日均，不给按平台的日均"
          }
        },
        "type": "object",
        "required": [
          "dates",
          "series",
          "total"
        ],
        "title": "TrendData"
      },
      "TrendMeta": {
        "properties": {
          "class_slug": {
            "type": "string",
            "title": "Class Slug"
          },
          "rule_version": {
            "type": "string",
            "title": "Rule Version"
          },
          "tz": {
            "type": "string",
            "title": "Tz"
          },
          "granularity": {
            "type": "string",
            "title": "Granularity"
          },
          "start_date": {
            "type": "string",
            "title": "Start Date"
          },
          "end_date": {
            "type": "string",
            "title": "End Date"
          },
          "platforms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Platforms"
          },
          "data_through": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data Through",
            "description": "全部平台中最新的事件时间（UTC）"
          },
          "data_through_by_platform": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Data Through By Platform",
            "description": "选中平台各自的截止时间（UTC），从该平台最新事件推断；生产应换成采集侧心跳与接收水位"
          },
          "partial_dates": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Partial Dates",
            "description": "不完整的本地日：含某平台截止时刻，或部分平台已为 null"
          },
          "source_tz_assumed": {
            "type": "boolean",
            "title": "Source Tz Assumed",
            "description": "选中平台里有源时区未与采集方确认的平台"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/SourceTzWarning"
            },
            "type": "array",
            "title": "Warnings",
            "description": "不影响结果返回的提示；没有时为空数组"
          },
          "sum": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Sum",
            "description": "区间合计，按平台与 all；null 按 0 计"
          },
          "plan": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Plan",
            "description": "查询规划：每段读的表与日期范围"
          },
          "cache": {
            "type": "string",
            "title": "Cache",
            "description": "hit | miss | stale"
          },
          "stale": {
            "type": "boolean",
            "title": "Stale"
          },
          "generated_at": {
            "type": "string",
            "title": "Generated At"
          }
        },
        "type": "object",
        "required": [
          "class_slug",
          "rule_version",
          "tz",
          "granularity",
          "start_date",
          "end_date",
          "platforms",
          "data_through",
          "data_through_by_platform",
          "partial_dates",
          "source_tz_assumed",
          "warnings",
          "sum",
          "plan",
          "cache",
          "stale",
          "generated_at"
        ],
        "title": "TrendMeta"
      },
      "TrendResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/TrendData"
          },
          "meta": {
            "$ref": "#/components/schemas/TrendMeta"
          }
        },
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "title": "TrendResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}